<Configuration>
  <Networking>Enable</Networking>
  <!-- Allocates native host GPU resources directly to streaming execution frames -->
  <VGpu>Enable</VGpu>
  <AudioInput>Enable</AudioInput>
  <VideoInput>Enable</VideoInput>
  <ClipboardRedirection>Disable</ClipboardRedirection>

  <!-- ADVANCED PERFORMANCE OVERRIDES -->
  <!-- Prevents background processor throttling during heavy media or stream updates -->
  <MemoryInMB>8192</MemoryInMB> 
  
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\Numa\Downloads\sanbos</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\sanbos</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>

  <LogonCommand>
    <Command>cmd.exe /c "start cmd.exe /k C:\Users\WDAGUtilityAccount\Desktop\sanbos\setup.bat"</Command>
  </LogonCommand>
</Configuration>